{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "document-generator": {
      "command": "npx",
      "args": [
        "--yes",
        "document-generator-mcp@latest"
      ]
    }
  }
}
